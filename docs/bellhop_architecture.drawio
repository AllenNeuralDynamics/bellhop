                <mxCell id="MpCrRf3VQOImDC203fc6-39" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;h1&gt;Bellhop - Trackable automated data movement/housekeeping&lt;/h1&gt;" vertex="1">
                    <mxGeometry height="70" width="720" x="40" as="geometry"/>
                </mxCell>
                <mxCell id="MpCrRf3VQOImDC203fc6-40" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=default;" value="Desktop software to handle data egress off of scientific acquisition machines.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A utilities library contains Protocol-matched, optimized data movement functions for various storage solutions (local, network, s3, google cloud)&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Each dataset has an &lt;b&gt;Job&amp;nbsp;&lt;/b&gt;submitted that contains one or more &lt;b&gt;Tasks&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- For example, compress this file, move data somewhere, then notify lab systems&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Jobs&amp;nbsp;&lt;/b&gt;are carried out by the bellhop engine, tracking successes and failing gracefully in a restartable manner&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Interaction occurs through a web UI, CLI, or importable python client library.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="780" x="40" y="70" as="geometry"/>
                </mxCell>
